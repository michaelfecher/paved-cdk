# Real AWS account ids for the paved-road registry.
# Copy to `.env` and fill in; `.env` is git-ignored so account ids stay private.
# When unset, the registry falls back to illustrative placeholder ids so the
# library still imports, synthesizes and tests offline.
#
#   export $(grep -v '^#' .env | xargs)   # load into the shell before cdk synth/deploy

PAVED_CDK_DEV_ACCOUNT_ID=111111111111
PAVED_CDK_PREPROD_ACCOUNT_ID=222222222222
PAVED_CDK_PROD_ACCOUNT_ID=333333333333
