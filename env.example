# Real AWS account ids for the paved-road registry.
# Copy to `.env` and fill in; `.env` is git-ignored so account ids stay private.
# When unset, the registry falls back to illustrative placeholder ids so the
# library still imports, synthesizes and tests offline.
#
# Account ids are per team and stage: PAVED_CDK_<TEAM>_<STAGE>_ACCOUNT_ID.
#
#   export $(grep -v '^#' .env | xargs)   # load into the shell before cdk synth/deploy

# team "ds"
PAVED_CDK_DS_DEV_ACCOUNT_ID=111111111111
PAVED_CDK_DS_PREPROD_ACCOUNT_ID=222222222222
PAVED_CDK_DS_PROD_ACCOUNT_ID=333333333333

# team "marketing" (illustrative second team)
PAVED_CDK_MARKETING_DEV_ACCOUNT_ID=444444444444
PAVED_CDK_MARKETING_PREPROD_ACCOUNT_ID=555555555555
PAVED_CDK_MARKETING_PROD_ACCOUNT_ID=666666666666
