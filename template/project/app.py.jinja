"""{{ project_name }} - generated from the Paved CDK template.

You only declare WHAT you want. Naming your `team` selects your three AWS accounts
(dev/preprod/prod) and resolves VPC, subnets, KMS, the IAM permissions boundary and
governance from the account for the deploy stage. Add more platform constructs below;
do not add vpc/env/kms/account arguments.
"""

import aws_cdk as cdk

from paved_cdk import PlatformStack, SecureDataApi

app = cdk.App()

stack = PlatformStack(
    app,
    "{{ project_slug }}",
    team="{{ team }}",  # selects the account baseline (VPC/KMS/...) per stage
    tags={
        "Owner": "{{ owner_email }}",
        "CostCenter": "{{ cost_center }}",
    },
)

SecureDataApi(stack, "DataApi")

app.synth()
