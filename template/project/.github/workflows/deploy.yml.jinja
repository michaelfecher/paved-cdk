name: deploy

# This caller is intentionally tiny and carries NO AWS config. The platform owns
# all deploy wiring (OIDC roles, account ids) via GitHub variables; a Data
# Scientist sets nothing AWS-specific. `copier update` bumps the @{{ platform_version }}
# ref so every project moves with the platform.
#
# Triggers (the reusable workflow decides what each one does):
#   PR (incl. close) -> ephemeral preview in dev / teardown
#   push main        -> deploy to dev
#   push tag v*      -> release: dev -> preprod -> prod
on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:
    types: [opened, synchronize, reopened, closed]

jobs:
  cdk:
    uses: {{ platform_repo }}/.github/workflows/cdk-deploy.yml@{{ platform_version }}
    with:
      stack_name: {{ project_slug }}
